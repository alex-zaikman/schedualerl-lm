APP_NAME=schedulerlm
APP_DEBUG=true

# Mint dev JWT: uv run python scripts/mint_dev_jwt.py --sub <user-id>
AUTH_JWT_SECRET=change-me-local-dev-secret
AUTH_JWT_ALGORITHM=HS256

LOG_LEVEL=DEBUG
LOG_FORMAT=%(asctime)s %(levelname)s [%(name)s] %(message)s

# DB_HOST=localhost for local uv run; docker compose overrides to "db" for the app service
DB_HOST=localhost
DB_PORT=5432
DB_USER=schedulerlm
DB_PASSWORD=localdev
DB_NAME=schedulerlm
DB_MIN_POOL_SIZE=1
DB_MAX_POOL_SIZE=10
DB_CONNECT_TIMEOUT=10
DB_CONNECT_RETRIES=3
DB_CONNECT_RETRY_DELAY=1.0

SCHEDULER_WEBHOOK_JWT_TTL_MINUTES=5
SCHEDULER_WEBHOOK_TIMEOUT_SECONDS=30
# SCHEDULER_SCHEDULER_ID=optional-stable-id-for-multi-replica

LLM_MODEL=ollama/llama3.2
LLM_API_BASE=http://localhost:11434
# LLM_API_KEY=optional
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Override in CI/CD to point at a managed prompt file
# LLM_TRIGGER_PARSE_PROMPT_PATH=app/prompts/trigger_parse.txt
